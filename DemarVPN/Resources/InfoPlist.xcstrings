    "NSNetworkExtensionUsageDescription": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy uses the system VPN tunnel for a secure connection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy использует системный VPN-туннель для защищённого подключения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy güvenli bağlantı için sistem VPN tünelini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy використовує системний VPN-тунель для захищеного підключення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy xavfsiz ulanish uchun tizim VPN tunnelidan foydalanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy 使用系统 VPN 隧道进行安全连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy 使用系統 VPN 通道進行安全連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy는 보안 연결을 위해 시스템 VPN 터널을 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy は安全な接続のためにシステム VPN トンネルを使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy usa el túnel VPN del sistema para una conexión segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy nutzt den System-VPN-Tunnel für eine sichere Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy utilise le tunnel VPN système pour une connexion sécurisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Demar Proxy सुरक्षित कनेक्शन के लिए सिस्टम VPN टनल का उपयोग करता है।"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This identifier is used for analytics and app diagnostics."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот идентификатор используется для аналитики и диагностики приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tanımlayıcı analitik ve uygulama tanılama için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей ідентифікатор використовується для аналітики та діагностики застосунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu identifikator analitika va ilova diagnostikasi uchun ishlatiladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标识符用于分析和应用诊断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此識別碼用於分析與 App 診斷。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식별자는 분석 및 앱 진단에 사용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この識別子は分析とアプリ診断に使用されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este identificador se usa para analítica y diagnóstico de la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kennung wird für Analysen und App-Diagnose verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant est utilisé pour l’analyse et le diagnostic de l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पहचानकर्ता ऐनालिटिक्स और ऐप डायग्नोस्टिक्स के लिए उपयोग होता है।"
          }
        }
      }
    }
  },
  "version": "1.0"
}
