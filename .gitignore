.DS_Store
.venv/
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Core assets/binaries (scripts/singbox-download-auto.py)
**/singbox/
**/singbox_macos/

# Local tooling scripts (tracked: sing-box downloader + iOS appex signing + libbox builder + TestFlight upload)
scripts/*
!scripts/singbox-download-auto.py
!scripts/sign-singbox-in-appex.sh
!scripts/libbox-build.py
!scripts/upload-testflight.ps1
!scripts/increment_version_auto.ps1
!scripts/increment_version_common.ps1
!scripts/ios-export-options.plist
!scripts/macos-export-options.plist
!scripts/macos-singbox-helper.entitlements
scripts/.env
scripts/AuthKey_*.p8

# Libbox (scripts/libbox-build.py)
ios/Frameworks/Libbox.xcframework/
